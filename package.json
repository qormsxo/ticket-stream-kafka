{
  "name": "ticket-stream-kafka",
  "version": "1.0.0",
  "description": "Apache Kafka & Redis Redlock 기반 고동시성 티켓팅 백엔드 엔진",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "start:worker:prod": "node dist/worker.main.js",
    "start:gateway:dev": "nest start --watch",
    "start:worker:booking": "cross-env WORKER_ROLE=booking WORKER_PORT=3001 ts-node src/worker.main.ts",
    "start:worker:seat": "cross-env WORKER_ROLE=seat WORKER_PORT=3002 ts-node src/worker.main.ts",
    "start:worker:payment": "cross-env WORKER_ROLE=payment WORKER_PORT=3003 ts-node src/worker.main.ts",
    "start:worker:notification": "cross-env WORKER_ROLE=notification WORKER_PORT=3004 ts-node src/worker.main.ts",
    "start:worker:outbox": "cross-env WORKER_ROLE=outbox WORKER_PORT=3005 ts-node src/worker.main.ts",
    "dev:stack": "concurrently -n gw,book,seat,pay,ntf,obx -c cyan,green,yellow,magenta,blue,white \"npm run start:gateway:dev\" \"npm run start:worker:booking\" \"npm run start:worker:seat\" \"npm run start:worker:payment\" \"npm run start:worker:notification\" \"npm run start:worker:outbox\"",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/microservices": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/typeorm": "^11.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "ioredis": "^5.8.1",
    "kafkajs": "^2.2.4",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.26",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.18.6",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
