NODE_ENV=development
HTTP_PORT=3000
WORKER_ROLE=booking
WORKER_PORT=3001

DB_HOST=localhost
DB_PORT=5432
DB_USER=ticket
DB_PASSWORD=ticket
DB_NAME=ticket
# 비우면 게이트웨이만 스키마를 생성한다. 워커는 WORKER_ROLE이 있으면 기본 false.
# DB_SYNCHRONIZE=true
DB_LOGGING=false

# Redlock 쿼럼 데모용 독립 노드 3대. 로컬 단일 노드로 줄이려면 URL 하나만 남겨도 동작한다.
REDIS_URLS=redis://localhost:6379,redis://localhost:6380,redis://localhost:6381

# 호스트에서 npm으로 실행할 때는 외부 리스너, Compose 앱 컨테이너는 kafka:29092 를 쓴다.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=ticket-stream

SEAT_HOLD_TTL_MS=180000
REDLOCK_TTL_MS=5000
REDLOCK_RETRY_COUNT=8
LOCK_TIMEOUT_MS=2000

PAYMENT_PROVIDER=fake
FAKE_PAYMENT_MODE=success
FAKE_PAYMENT_DELAY_MS=20
FAKE_PAYMENT_FAIL_RATE=0.2

SEED_ON_BOOT=true
SEED_SEAT_COUNT=100

OUTBOX_POLL_MS=500
OUTBOX_BATCH_SIZE=100
